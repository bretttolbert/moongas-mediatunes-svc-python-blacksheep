# Copy to .env and adjust for your setup.
# Local dev-server settings for the Vite proxy (loaded by vite.config.ts).

# Base URL of the Flask backend (JSON API + media files).
FLASK_BACKEND_URL=http://127.0.0.1:5000

# Must match flaskConfig.urlPrefix in mediaserver-config.yml (empty when unset).
# Example when urlPrefix is /mediaserver:
# FLASK_URL_PREFIX=/mediaserver
FLASK_URL_PREFIX=
