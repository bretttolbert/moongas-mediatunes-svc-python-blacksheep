[Unit]
# Flask backend: serves the JSON API (/mediaserver/api/*) and media files
# (/mediaserver/getfile/*). The web frontend is served by mediaserver-web.service.
Description=mediaserver (Flask JSON API backend)
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/var/www/moongas
ExecStart=/var/www/moongas/.venv/bin/python -m mediaserver mediaserver-config.yml
Restart=always
RestartSec=30s
Type=simple

[Install]
WantedBy=multi-user.target